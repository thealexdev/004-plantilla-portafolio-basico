---
// Card.astro

interface Props {
    titulo: string;
    fecha: string;
    parrafo: string;
}

const astroProps = Astro.props as Props;
const { titulo, fecha, parrafo } = astroProps;
---

<article class="experiencia-card">
    <h3 class="experience-title">{titulo}</h3>
    <span class="experience-date">{fecha}</span>
    <p class="experience-description">{parrafo}</p>
</article>
